# secrets.lux — contraseñas y tokens en el llavero del sistema (módulo keyring,
# que usa `secret-tool` de libsecret-tools), nunca en SQLite.
# (El servicio del llavero sigue llamándose "lux-mail" del nombre antiguo: cambiarlo dejaría sin acceso a las contraseñas ya guardadas.)
# Si el llavero no responde (falta secret-tool, está bloqueado...) devuelven "" / false en vez de abortar:
# quien llama decide qué hacer (las rutas responden con un error claro).

fn string secret_get(int account_id):
    try:
        return str(must(await keyring.get("lux-mail", str(account_id))))
    catch:
        return ""

fn bool secret_set(int account_id, string value):
    try:
        must(await keyring.set("lux-mail", str(account_id), value))
        return true
    catch:
        return false

fn void secret_clear(int account_id):
    try:
        must(await keyring.delete("lux-mail", str(account_id)))
    catch:
        log.warn("no se pudo borrar el secreto de la cuenta " + str(account_id))
