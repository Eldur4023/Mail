# update.lux — actualizaciones desde GitHub, como Drive de escritorio.
# deploy/install.sh deja en /opt/mail-desktop de qué repositorio y commit se instaló; la
# app compara ese commit con el de GitHub y, si hay cambios, lanza deploy/update.sh
# (pull, compilar y `pkexec install.sh`) en segundo plano.

fn string opt_dir():
    return os.getenv("MAIL_OPT", "/opt/mail-desktop")

fn string update_log():
    return os.path_join(os.getenv("HOME", "/tmp"), ".cache/mail-update.log")

fn string source_repo():
    if not os.path_exists(opt_dir() + "/source"):
        return ""
    string repo = await os.read_file(opt_dir() + "/source")
    return repo.trim()

# git sin preguntar nunca credenciales por terminal (no hay terminal: se colgaría).
# `env` en vez de una opción de os.run, que en este runtime no admite entorno.
fn Json git(string repo, List<string> args):
    List<string> argv = ["GIT_TERMINAL_PROMPT=0", "git", "-C", repo]
    for int i in range(0, len(args)):
        argv.add(args[i])
    return await os.run("env", argv)

get endpoint("/api/update"):
    require api_ok() else status(401)
    string repo = await source_repo()
    if repo == "" or not os.is_dir(repo):
        return { "available": false, "error": "instalación sin repositorio de origen (reinstala con deploy/install.sh)" }
    string current = ""
    if os.path_exists(opt_dir() + "/version"):
        string v = await os.read_file(opt_dir() + "/version")
        current = v.trim()
    if current == "":
        Json head = await git(repo, ["rev-parse", "HEAD"])
        current = str(head["stdout"]).trim()
    Json f = await git(repo, ["fetch", "-q"])
    string ferr = native_error(f)
    if ferr != "" or f["status"] != 0:
        return { "available": false, "error": "no se pudo consultar GitHub: " + (ferr != "" ? ferr : str(f["stderr"]).trim()) }
    Json log = await git(repo, ["log", "--format=%h %s", current + "..@{u}"])
    List<string> commits = []
    List<string> lines = str(log["stdout"]).split("\n")
    for int i in range(0, len(lines)):
        if lines[i].trim() != "":
            commits.add(lines[i].trim())
    return { "available": len(commits) > 0, "commits": commits }

post endpoint("/api/update"):
    require api_ok() else status(401)
    string repo = await source_repo()
    require repo != "" else status(400)
    os.make_dir(os.path_dirname(update_log()))
    # setsid -f: el script sigue aunque se cierre la ventana; la salida, al registro.
    await os.run("setsid", ["-f", "env", "GIT_TERMINAL_PROMPT=0", "bash", "-c", "exec bash \"$0\" > \"$1\" 2>&1 < /dev/null",
        os.path_join(repo, "deploy/update.sh"), update_log()])
    return { "ok": true }

get endpoint("/api/update/log"):
    require api_ok() else status(401)
    if not os.path_exists(update_log()):
        return { "state": "idle", "log": "" }
    string text = await os.read_file(update_log())
    string st = "running"
    if text.contains("==> LISTO"):
        st = "done"
    else if text.contains("==> ERROR"):
        st = "error"
    if len(text) > 4000:
        text = text.slice(len(text) - 4000, len(text))
    return { "state": st, "log": text }
