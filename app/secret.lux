# secret.lux — el secreto de la API local.
#
# El servidor escucha en 127.0.0.1, pero en un teléfono (y en un equipo con varios usuarios) otras apps
# pueden abrir ese puerto y leer el correo. Así que toda la API exige la cabecera X-Mail-Token con el
# secreto de `api-token` (carpeta de datos de la app, modo 600). Quien abre la página —la ventana de
# escritorio o la actividad de Android— lo lee de ese fichero y se lo pasa en `#t=…`; main.js lo pone en
# cada petición. Las rutas lo comprueban con `require api_ok() else status(401)`.
# El servidor sin secreto nunca llega a escuchar: se crea antes de abrir el puerto.

on start:
    string token = ""
    if os.path_exists("api-token"):
        string saved = await os.read_file("api-token")
        token = saved.trim()
    if token == "":
        token = hash.token(32)
        await os.write_file("api-token", token)
    os.chmod("api-token", "600")
    state.set("api_token", token)

fn bool api_ok():
    string want = str(state.get("api_token", ""))
    return want != "" and hash.equal(header("X-Mail-Token", ""), want)
